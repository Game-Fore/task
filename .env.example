# без .env используются те же значения по умолчанию из docker-compose.yml

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# смените, если 5432 на хосте занят
POSTGRES_HOST_PORT=5432

SOURCE_DB=deals_bigdata
DWH_DB=dwh

# размер синтетического источника, применяется только при создании volume
N_PRICES=300000

# окно загрузки по loading_date, включая будущие заявки для скоринга
ETL_START_DATE=2023-01-01
ETL_END_DATE=2027-12-31

# дата снимка, от неё считаются история витрины, свежесть и split для ML
AS_OF=2026-10-26

LOG_LEVEL=INFO
