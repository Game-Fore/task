# Скопируйте в .env, чтобы переопределить значения. Без .env docker-compose использует
# значения по умолчанию из docker-compose.yml (они совпадают с указанными здесь).

# PostgreSQL 17: в прототипе один пользователь на источник и хранилище
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Порт на хосте; смените, если 5432 занят локальным PostgreSQL
POSTGRES_HOST_PORT=5432

# Базы данных: операционный источник и аналитическое хранилище (raw/core/mart)
SOURCE_DB=deals_bigdata
DWH_DB=dwh

# Объём синтетического источника (sql/source/synthetic.sql); применяется только при первой инициализации volume
N_PRICES=300000

# Окно загрузки по prices.loading_date (границы включительно) для `python -m etl load` без параметров.
# По умолчанию покрывает всю историю и плановые погрузки после даты снимка (нужны для ML-скоринга).
ETL_START_DATE=2023-01-01
ETL_END_DATE=2027-12-31

LOG_LEVEL=INFO
